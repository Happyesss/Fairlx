# Copy to .env.selfhost.local (gitignored via .env*.local) and fill in.
# Used by: npx tsx scripts/migrate-cloud-to-selfhost.ts migrate

SELFHOST_ENDPOINT=https://appwrite.fairlx.com/v1
SELFHOST_CONSOLE_EMAIL=
SELFHOST_CONSOLE_PASSWORD=

# Optional. Defaults to creating project id "fairlx" in org "Fairlx".
SELFHOST_PROJECT=6a9951e1003396cf56f1
SELFHOST_PROJECT_NAME=Fairlx
SELFHOST_ORG_NAME=Fairlx
# SELFHOST_ORG_ID=
# SELFHOST_KEY=

SELFHOST_PLATFORMS=localhost,app.fairlx.com,fairlx.com

# Project Messaging SMTP (instance _APP_SMTP_* is configured on the server).
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USERNAME=
# SMTP_PASSWORD=
# SMTP_ENCRYPTION=tls
# SMTP_FROM=contact@fairlx.com
# SMTP_FROM_NAME=Fairlx

# Appwrite Auth OAuth (not the GitHub integration app in .env.local).
# AUTH_GITHUB_CLIENT_ID=
# AUTH_GITHUB_CLIENT_SECRET=
# AUTH_GOOGLE_CLIENT_ID=
# AUTH_GOOGLE_CLIENT_SECRET=
